// EasyMute resource script
// Keep this file pure ASCII: Chinese UI strings are applied at runtime via SetDlgItemTextW,
// avoiding codepage differences between rc.exe (MSVC) and windres (MinGW).

// windows.h supplies the WS_* / DS_* style macros that windres needs
#include <windows.h>

#include "resource.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

// Application icon (multi-size ICO generated by tools/make_icon.ps1)
IDI_APPICON             ICON                    "app.ico"

// Application manifest (PerMonitorV2 DPI / asInvoker / common controls v6)
1 RT_MANIFEST "app.manifest"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "buwenqu"
            VALUE "FileDescription", "EasyMute - Mute the focused app with one hotkey"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "EasyMute"
            VALUE "OriginalFilename", "EasyMute.exe"
            VALUE "ProductName", "EasyMute"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Settings dialog (all texts are set at runtime in WM_INITDIALOG)
IDD_SETTINGS DIALOGEX 0, 0, 236, 136
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EasyMute"
FONT 9, "Microsoft YaHei UI", 400, 0, 1
BEGIN
    LTEXT           "", IDC_STATIC_HKLABEL, 12, 16, 40, 12
    CONTROL         "", IDC_HOTKEYBOX, "EasyMuteHotkeyBox", WS_TABSTOP, 56, 14, 100, 16
    PUSHBUTTON      "", IDC_BTN_DEFAULT, 162, 14, 62, 16
    AUTOCHECKBOX    "", IDC_CHK_AUTOSTART, 12, 46, 140, 12
    AUTOCHECKBOX    "", IDC_CHK_NOTIFY, 12, 66, 150, 12
    LTEXT           "", IDC_STATIC_VERSION, 12, 104, 100, 12
    PUSHBUTTON      "", IDC_BTN_CLOSE, 162, 102, 62, 16
END
